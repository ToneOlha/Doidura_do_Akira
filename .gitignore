# Ignorar o ambiente virtual (crucial para o seu caso!)
venv/
.venv/
env/

# Ignorar arquivos temporários que o Python cria sozinho ao rodar o código
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignorar arquivos de configuração do seu editor de código (opcional)
.vscode/
.idea/

# Ignorar arquivos do próprio sistema operacional
Thumbs.db
.DS_Store